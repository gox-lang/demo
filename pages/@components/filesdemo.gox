module filesdemo

import (
	editor "@components/editor.gox"
	fmt "fmt"
	gox "github.com/gox-lang/gox"
)

const actionSource = `func RoundTripFile(file gox.File) gox.Action {
    if file.Size() > 1 << 20 {
        return fmt.Errorf("Choose a file up to 1 MiB.")
    }
    return file
}`

const socketSource = `socket.On("roundTripFile", func(file gox.File) gox.EventReply {
        if file.Size() > 1 << 20 {
            return fmt.Errorf("Choose a file up to 1 MiB.")
        }
        return file
    })`

const actionCall = `import Actions from "@gox/actions";
import { socket, socketErrorListeners } from "/chat-demo.js";

const urls = new Map();
let transferError = null;
socketErrorListeners.add(error => {
    if (error.event === "roundTripFile") transferError = error;
});
for (const form of document.querySelectorAll("[data-file-transfer]")) {
    const panel = form.closest(".http-playground");
    const status = panel.querySelector("[role=status]");
    const result = panel.querySelector("[data-file-result]");
    const button = form.querySelector("button");
    form.addEventListener("submit", async event => {
        event.preventDefault();
        const file = form.elements.file.files[0];
        if (!file || file.size > 1048576) {
            status.textContent = "Choose a file up to 1 MiB.";
            return;
        }
        if (urls.has(form)) URL.revokeObjectURL(urls.get(form));
        urls.delete(form);
        result.replaceChildren();
        button.disabled = true;
        status.textContent = "Sending the file and waiting for it to return…";
        try {
            let received;
            if (form.dataset.fileTransfer === "action") {
                const [value, err] = await Actions.RoundTripFile(form);
                if (err) throw new Error(err.message);
                received = value;
            } else {
                if (socket.state !== "connected") {
                    throw new Error("Wait for WebSocket to connect.");
                }
                transferError = null;
                received = await socket.emit("roundTripFile", form);
                if (transferError) throw new Error(transferError.message);
            }
            if (!(received instanceof File)) {
                throw new Error("No valid file was received.");
            }
            const url = URL.createObjectURL(received);
            urls.set(form, url);
            const name = document.createElement("strong");
            name.textContent = received.name;
            const details = document.createElement("p");
            details.textContent = received.size + " bytes · " + (received.type || "No MIME type");
            const download = document.createElement("a");
            download.className = "button primary";
            download.href = url;
            download.download = received.name;
            download.textContent = "Download file ↓";
            result.append(name, details, download);
            status.textContent = "File received. You can download it now.";
        } catch (error) {
            status.textContent = error.message || "The transfer failed. Try again.";
        } finally {
            button.disabled = false;
        }
    });
}`

const socketCall = `import Actions from "@gox/actions";
import { socket, socketErrorListeners } from "/chat-demo.js";

const urls = new Map();
let transferError = null;
socketErrorListeners.add(error => {
    if (error.event === "roundTripFile") transferError = error;
});
for (const form of document.querySelectorAll("[data-file-transfer]")) {
    const panel = form.closest(".http-playground");
    const status = panel.querySelector("[role=status]");
    const result = panel.querySelector("[data-file-result]");
    const button = form.querySelector("button");
    form.addEventListener("submit", async event => {
        event.preventDefault();
        const file = form.elements.file.files[0];
        if (!file || file.size > 1048576) {
            status.textContent = "Choose a file up to 1 MiB.";
            return;
        }
        if (urls.has(form)) URL.revokeObjectURL(urls.get(form));
        urls.delete(form);
        result.replaceChildren();
        button.disabled = true;
        status.textContent = "Sending the file and waiting for it to return…";
        try {
            let received;
            if (form.dataset.fileTransfer === "action") {
                const [value, err] = await Actions.RoundTripFile(form);
                if (err) throw new Error(err.message);
                received = value;
            } else {
                if (socket.state !== "connected") {
                    throw new Error("Wait for WebSocket to connect.");
                }
                transferError = null;
                received = await socket.emit("roundTripFile", form);
                if (transferError) throw new Error(transferError.message);
            }
            if (!(received instanceof File)) {
                throw new Error("No valid file was received.");
            }
            const url = URL.createObjectURL(received);
            urls.set(form, url);
            const name = document.createElement("strong");
            name.textContent = received.name;
            const details = document.createElement("p");
            details.textContent = received.size + " bytes · " + (received.type || "No MIME type");
            const download = document.createElement("a");
            download.className = "button primary";
            download.href = url;
            download.download = received.name;
            download.textContent = "Download file ↓";
            result.append(name, details, download);
            status.textContent = "File received. You can download it now.";
        } catch (error) {
            status.textContent = error.message || "The transfer failed. Try again.";
        } finally {
            button.disabled = false;
        }
    });
}`

func RoundTripFile(file gox.File) gox.Action {
	if file.Size() > 1<<20 {
		return fmt.Errorf("Choose a file up to 1 MiB.")
	}
	return file
}
func Showcase() gox.Component {
	return <section class="wrap demo-section" id="files">
		<div class="section-heading">
			<div>
				<span class="eyebrow">07 / FILES</span>
				<h2>There and back.<br />The same file, two paths.</h2>
			</div>
			<p>Send a file to GOX and download it back. Compare Actions and WebSocket with the same content, without storing it permanently on the server.</p>
		</div>
		<div class="lab demo-panel">
			<div class="framework-strip" role="tablist" aria-label="Transferencia de archivos">
				<button
					type="button"
					role="tab"
					id="files-tab-action"
					aria-controls="files-panel-action"
					aria-selected="true"
					tabindex="0"
					class="framework-active"
					data-files-tab
				>Actions</button>
				<button
					type="button"
					role="tab"
					id="files-tab-socket"
					aria-controls="files-panel-socket"
					aria-selected="false"
					tabindex="-1"
					class=""
					data-files-tab
				>WebSocket</button>
			</div>
			<div role="tabpanel" id="files-panel-action" aria-labelledby="files-tab-action">
				<div class="http-example-grid">
					<div class="http-source">
						<div class="pane-heading">
							<span>GOX · Actions</span>
							<button
								type="button"
								class="copy-button"
								data-copy-target="files-source-action"
							>Copy code</button>
						</div>
						<pre class="framework-code">
							<&editor.Code
								source={{ actionSource }}
								id="files-source-action"
								padding={{ 1 }}
							/>
						</pre>
						<div class="pane-heading">
							<span>files-demo.js · complete</span>
							<button
								type="button"
								class="copy-button"
								data-copy-target="files-call-action"
							>Copy code</button>
						</div>
						<pre class="framework-code">
							<&editor.JavaScript
								source={{ actionCall }}
								id="files-call-action"
								padding={{ 1 }}
							/>
						</pre>
					</div>
					<div class="http-playground">
						<span class="eyebrow">Actions</span>
						<h3>A file, there and back.</h3>
						<p>Choose a file up to 1 MiB. GOX returns its content, name, and type for download.</p>
						<form id="file-form-action" data-file-transfer="action">
							<label for="file-input-action">Your file</label>
							<input id="file-input-action" type="file" name="file" required />
							<button type="submit" class="button primary">Send file ↑</button>
						</form>
						<p class="http-status" role="status">Ready to transfer.</p>
						<div class="http-result file-result" data-file-result aria-live="polite">The returned file will appear here.</div>
					</div>
				</div>
			</div>
			<div role="tabpanel" id="files-panel-socket" aria-labelledby="files-tab-socket" hidden>
				<div class="http-example-grid">
					<div class="http-source">
						<div class="pane-heading">
							<span>GOX · WebSocket</span>
							<button
								type="button"
								class="copy-button"
								data-copy-target="files-source-socket"
							>Copy code</button>
						</div>
						<pre class="framework-code">
							<&editor.Code
								source={{ socketSource }}
								id="files-source-socket"
								padding={{ 1 }}
							/>
						</pre>
						<div class="pane-heading">
							<span>files-demo.js · complete</span>
							<button
								type="button"
								class="copy-button"
								data-copy-target="files-call-socket"
							>Copy code</button>
						</div>
						<pre class="framework-code">
							<&editor.JavaScript
								source={{ socketCall }}
								id="files-call-socket"
								padding={{ 1 }}
							/>
						</pre>
					</div>
					<div class="http-playground">
						<span class="eyebrow">WebSocket</span>
						<h3>A file, there and back.</h3>
						<p>Choose a file up to 1 MiB. GOX returns its content, name, and type for download.</p>
						<form id="file-form-socket" data-file-transfer="socket">
							<label for="file-input-socket">Your file</label>
							<input id="file-input-socket" type="file" name="file" required />
							<button type="submit" class="button primary">Send file ↑</button>
						</form>
						<p class="http-status" role="status">Ready to transfer.</p>
						<div class="http-result file-result" data-file-result aria-live="polite">The returned file will appear here.</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}
